' file, You can obtain one at https://mozilla.org/MPL/2.0/.

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 60

title Face liveness and PAD in the Registration Client: components

node "Biometric device (L0/L1)" {
  [Vendor device service\nor mock-sbi] as sbi
}

package "Registration Client 1.2.0.2 (Java 11, JavaFX)" {

  package "registration-client" {
    [SBI providers\n0.9.2 / 0.9.5 / 1.0] as providers
    [Streamer\npreview, frame listener] as streamer
    [Capture and authentication\ncontrollers] as controllers
    [LivenessStatusPane] as pane
  }

  package "registration-services: liveness" {
    [LivenessFrameSource] as adapter
    [LivenessService\nLivenessCapture\nLivenessEngineProvider] as service
    [LivenessConfigProvider] as config
    [LivenessStatusModel\nLivenessMessages] as model
    [LivenessAuditListener\nwriter thread] as auditlistener
    [Audit service] as audit
  }

  package "liveness-engine (JAR)" {
    [Session\nSessionCore, FrameWorker] as session
    [Frame analysis\nYuNet, quality, MiniFASNet x2] as passive
    [Active check\nchallenges, Face Mesh V2] as active
    [ModelManifest\nmodels.json] as manifest
    [ONNX Runtime, CPU] as ort
  }
}

sbi --> providers : STREAM, RCAPTURE
providers --> streamer : frames
streamer --> adapter : JPEG bytes
adapter --> session : frames, device events
controllers --> service : scan
config --> service : policy
service --> session : open, capture check
session --> passive
session --> active
passive --> ort
active --> ort
manifest --> ort : verified models
session ..> controllers : updates
controllers --> pane
pane --> model
session ..> auditlistener : events, no image
auditlistener --> audit
@enduml
